{
  "name": "callassistent",
  "version": "1.0.0",
  "description": "Aplicativo Windows para gravação, transcrição com IA e atas de reunião",
  "main": "electron/main.cjs",
  "scripts": {
    "backend": ".\\venv\\Scripts\\python.exe backend/run_backend.py",
    "dev:ui": "vite",
    "electron": "electron electron/main.cjs",
    "dev": "concurrently -k -p \"[{name}]\" -n \"BACKEND,FRONTEND,APP\" -c \"yellow,blue,green\" \"npm run backend\" \"npm run dev:ui\" \"wait-on tcp:8765 && wait-on http://localhost:5173 && npm run electron\""
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  }
}
