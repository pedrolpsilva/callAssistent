{
  "name": "callassistent",
  "version": "1.0.0",
  "description": "Aplicativo Web para gravação, transcrição com IA e atas de reunião (Google Chrome no macOS e Windows)",
  "scripts": {
    "backend": "python backend/run_backend.py",
    "backend:win": ".\\venv\\Scripts\\python.exe backend/run_backend.py",
    "dev:ui": "vite --open",
    "dev": "concurrently -k -p \"[{name}]\" -n \"BACKEND,WEB\" -c \"yellow,cyan\" \"npm run backend:win\" \"npm run dev:ui\"",
    "dev:mac": "concurrently -k -p \"[{name}]\" -n \"BACKEND,WEB\" -c \"yellow,cyan\" \"python3 backend/run_backend.py\" \"npm run dev:ui\"",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
